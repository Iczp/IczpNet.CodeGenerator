{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build generator",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "IczpNet.CodeGenerator.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dev vue ui",
      "type": "process",
      "command": "pnpm.cmd",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}/ui/IczpNet.CodeGenerator.WebUi" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": [{ "regexp": "." }],
        "background": { "activeOnStart": true, "beginsPattern": "Local", "endsPattern": "ready in" }
      }
    }
  ]
}
